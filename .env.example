# Demo mode uses controlled local data and a real local Chromium browser.
# Live mode NEVER falls back to simulated TinyFish results.
APP_MODE=demo
PORT=8000
APP_URL=http://localhost:3000
WORKER_URL=http://127.0.0.1:8000
DATA_DIR=./data
TINYFISH_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_CLASSIFICATION_MODEL=gemini-3.5-flash-lite
PUBLIC_DEMO_URL=
WEBHOOK_SECRET=
# Optional Google sign-in and Gmail connection
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Optional managed authentication
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional notification providers
RESEND_API_KEY=
MAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GMAIL_POLL_INTERVAL_SECONDS=600
